+++ b/src/external_signals.py
@@ -0,0 +1,167 @@
+"""
+Cross-exchange + aggregator signal tracker.
+
+Polls OKX / Bybit / Crypto.com / CoinGecko (and CoinMarketCap if a key is
+configured) on their own low-frequency schedule (these are context signals,
+not tick data) and exposes a snapshot() dict that scoring.py reads.
+
+Design mirrors funding.py / oi.py: a small stateful tracker with its own
+Ring history, isolated from the Binance websocket/REST path so a slow or
+down third-party endpoint can never block or crash the primary feed.
+
+Missing data is represented explicitly (None / present=False in the reason
+string) rather than silently defaulted to "neutral" — scoring.py is
+responsible for deciding how to score an absent signal (currently: no
+points, not a fabricated midpoint), matching the existing convention for
+ls_account_ratio / top_pos_ratio in scoring.py's _ratio_to_long_100.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import time
+
+from config import get
+from src.external_venues import (
+    bybit_funding_and_price,
+    cmc_api_key,
+    coingecko_global,
+    coinmarketcap_global,
+    cryptocom_ticker,
+    okx_funding_and_price,
+)
+from src.utils import Ring, now_ms, safe_float
+
+log = logging.getLogger(__name__)
+
+# Binance symbol -> per-venue instrument id. Extend as more symbols are traded.
+_SYMBOL_MAP = {
+    "BTCUSDT": {"okx": "BTC-USDT-SWAP", "bybit": "BTCUSDT", "cryptocom": "BTCUSD-PERP"},
+    "ETHUSDT": {"okx": "ETH-USDT-SWAP", "bybit": "ETHUSDT", "cryptocom": "ETHUSD-PERP"},
+}
+
+
+class ExternalSignalTracker:
+    def __init__(self, symbol: str):
+        self.symbol = symbol.upper()
+        self.venue_ids = _SYMBOL_MAP.get(self.symbol)
+        self._lock = threading.Lock()
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+
+        self.cross_funding: dict = {}      # per-venue funding + Binance comparison
+        self.cross_basis: dict = {}        # per-venue price + Binance comparison
+        self.regime: dict = {}             # CoinGecko/CMC dominance + mcap momentum
+        self.regime_hist = Ring(500)       # for momentum of dominance itself
+        self.last_poll_ts = 0.0
+        self.last_regime_poll_ts = 0.0
+        self.available = self.venue_ids is not None
+
+    def start(self) -> None:
+        if not self.available:
+            log.info("external_signals: no venue map for %s, tracker idle", self.symbol)
+            return
+        self._thread = threading.Thread(target=self._loop, daemon=True, name="external-signals")
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._stop.set()
+
+    # -- polling ------------------------------------------------------------
+
+    def _loop(self) -> None:
+        cross_poll_s = float(get("external_signals.cross_venue_poll_s", 30.0))
+        regime_poll_s = float(get("external_signals.regime_poll_s", 300.0))
+        while not self._stop.is_set():
+            now = time.time()
+            try:
+                if now - self.last_poll_ts >= cross_poll_s:
+                    self._poll_cross_venue()
+                    self.last_poll_ts = now
+                if now - self.last_regime_poll_ts >= regime_poll_s:
+                    self._poll_regime()
+                    self.last_regime_poll_ts = now
+            except Exception:
+                log.exception("external_signals loop")
+            self._stop.wait(2.0)
+
+    def _poll_cross_venue(self, binance_funding: float | None = None, binance_price: float | None = None) -> None:
+        ids = self.venue_ids
+        okx = okx_funding_and_price(ids["okx"])
+        bybit = bybit_funding_and_price(ids["bybit"])
+        ccom = cryptocom_ticker(ids["cryptocom"])
+        with self._lock:
+            self._last_okx, self._last_bybit, self._last_ccom = okx, bybit, ccom
+
+    def _poll_regime(self) -> None:
+        cg = coingecko_global()
+        cmc = coinmarketcap_global(cmc_api_key())
+        src = cg or cmc  # CoinGecko preferred (no key needed); CMC as fallback
+        if src is None:
+            return
+        with self._lock:
+            prev = self.regime.get("btc_dominance_pct")
+            self.regime = {
+                **src,
+                "source": "coingecko" if src is cg else "coinmarketcap",
+                "btc_dominance_chg_from_prev_poll": (
+                    src["btc_dominance_pct"] - prev if prev is not None else None
+                ),
+            }
+            self.regime_hist.append({"ts": now_ms(), "btc_dominance_pct": src["btc_dominance_pct"]})
+
+    # -- feature computation --------------------------------------------------
+
+    def compute(self, binance_funding: float | None, binance_price: float | None) -> dict:
+        """
+        Called from the score loop (cheap, no I/O — just combines whatever
+        the background poller last fetched with the live Binance values).
+        """
+        with self._lock:
+            okx = getattr(self, "_last_okx", None)
+            bybit = getattr(self, "_last_bybit", None)
+            ccom = getattr(self, "_last_ccom", None)
+            regime = dict(self.regime) if self.regime else {}
+            hist = list(self.regime_hist)
+
+        venues = [v for v in (okx, bybit) if v and v.get("funding_rate") is not None]
+        funding_divergence = None
+        funding_reason = "no cross-exchange funding data yet"
+        if venues and binance_funding is not None:
+            avg_other = sum(v["funding_rate"] for v in venues) / len(venues)
+            funding_divergence = safe_float(binance_funding) - avg_other
+            names = "/".join(v["venue"] for v in venues)
+            funding_reason = (
+                f"Binance funding {binance_funding:+.6f} vs {names} avg {avg_other:+.6f} "
+                f"(divergence {funding_divergence:+.6f})"
+            )
+
+        price_venues = [v for v in (okx, bybit, ccom) if v and v.get("price")]
+        basis_pct = None
+        basis_reason = "no cross-exchange price data yet"
+        if price_venues and binance_price:
+            avg_other_px = sum(v["price"] for v in price_venues) / len(price_venues)
+            basis_pct = (safe_float(binance_price) - avg_other_px) / avg_other_px * 100.0 if avg_other_px else None
+            names = "/".join(v["venue"] for v in price_venues)
+            basis_reason = (
+                f"Binance {binance_price:,.2f} vs {names} avg {avg_other_px:,.2f} "
+                f"(basis {basis_pct:+.4f}% — Binance-specific leverage/liquidity skew if wide)"
+            )
+
+        dom_momentum = None
+        if len(hist) >= 2:
+            dom_momentum = hist[-1]["btc_dominance_pct"] - hist[0]["btc_dominance_pct"]
+
+        return {
+            "cross_funding_divergence": funding_divergence,
+            "cross_funding_reason": funding_reason,
+            "cross_funding_venues": [v["venue"] for v in venues],
+            "cross_basis_pct": basis_pct,
+            "cross_basis_reason": basis_reason,
+            "cross_basis_venues": [v["venue"] for v in price_venues],
+            "btc_dominance_pct": regime.get("btc_dominance_pct"),
+            "btc_dominance_momentum": dom_momentum,
+            "total_mcap_chg_24h_pct": regime.get("total_mcap_chg_24h_pct"),
+            "regime_source": regime.get("source"),
+        }
