index 0000000..b04bd12
--- /dev/null
+++ b/src/external_venues.py
@@ -0,0 +1,152 @@
+"""
+Public, keyless REST clients for cross-exchange and aggregator context data.
+
+These are NOT the primary feed (Binance still is). They exist to answer:
+  - is Binance funding/price an outlier vs the rest of the market, or is the
+    whole market positioned the same way?
+  - is the broader market (BTC dominance / total cap momentum) rotating in a
+    way that supports or contradicts a single-symbol trap read?
+
+Every function fails soft: on any network/parspace error it returns None (or
+an empty dict) rather than raising, so a slow/down third-party endpoint never
+takes the dashboard down. Callers must treat missing data as "unknown", not
+"neutral/zero" — see external_signals.py for how that's handled.
+"""
+
+from __future__ import annotations
+
+import time
+from typing import Any
+
+import requests
+
+from config import get
+
+_UA = {"Accept": "application/json", "User-Agent": "gt-dashboard/1.0"}
+
+
+def _get(url: str, params: dict | None = None, timeout: float = 6.0) -> Any:
+    try:
+        r = requests.get(url, params=params, timeout=timeout, headers=_UA)
+        if r.status_code >= 400:
+            return None
+        return r.json()
+    except (requests.RequestException, ValueError):
+        return None
+
+
+# --------------------------------------------------------------------------
+# Cross-exchange perp funding + mark price (keyless)
+# --------------------------------------------------------------------------
+
+def okx_funding_and_price(inst_id: str) -> dict | None:
+    """inst_id e.g. 'BTC-USDT-SWAP'."""
+    fr = _get("https://www.okx.com/api/v5/public/funding-rate", {"instId": inst_id})
+    tk = _get("https://www.okx.com/api/v5/market/ticker", {"instId": inst_id})
+    try:
+        frow = (fr or {}).get("data", [{}])[0]
+        trow = (tk or {}).get("data", [{}])[0]
+        return {
+            "venue": "okx",
+            "funding_rate": float(frow.get("fundingRate")) if frow.get("fundingRate") else None,
+            "price": float(trow.get("last")) if trow.get("last") else None,
+            "ts": int(time.time() * 1000),
+        }
+    except (TypeError, ValueError, IndexError, KeyError):
+        return None
+
+
+def bybit_funding_and_price(symbol: str) -> dict | None:
+    """symbol e.g. 'BTCUSDT' (linear perp)."""
+    data = _get(
+        "https://api.bybit.com/v5/market/tickers",
+        {"category": "linear", "symbol": symbol},
+    )
+    try:
+        row = (data or {}).get("result", {}).get("list", [{}])[0]
+        return {
+            "venue": "bybit",
+            "funding_rate": float(row.get("fundingRate")) if row.get("fundingRate") else None,
+            "price": float(row.get("lastPrice")) if row.get("lastPrice") else None,
+            "ts": int(time.time() * 1000),
+        }
+    except (TypeError, ValueError, IndexError, KeyError):
+        return None
+
+
+def cryptocom_ticker(instrument: str) -> dict | None:
+    """instrument e.g. 'BTCUSD-PERP' on Crypto.com Exchange public API."""
+    data = _get(
+        "https://api.crypto.com/exchange/v1/public/get-tickers",
+        {"instrument_name": instrument},
+    )
+    try:
+        row = (data or {}).get("result", {}).get("data", [{}])[0]
+        # 'a' = best ask, 'b' = best bid on Crypto.com's ticker schema
+        bid = float(row.get("b")) if row.get("b") else None
+        ask = float(row.get("a")) if row.get("a") else None
+        mid = (bid + ask) / 2.0 if bid and ask else None
+        return {
+            "venue": "crypto.com",
+            "price": mid,
+            "volume_24h": float(row.get("v")) if row.get("v") else None,
+            "ts": int(time.time() * 1000),
+        }
+    except (TypeError, ValueError, IndexError, KeyError):
+        return None
+
+
+# --------------------------------------------------------------------------
+# Aggregator / macro-regime context (keyless: CoinGecko public API)
+# --------------------------------------------------------------------------
+
+def coingecko_global() -> dict | None:
+    """BTC dominance + total market cap, used as a coarse regime signal."""
+    data = _get("https://api.coingecko.com/api/v3/global")
+    try:
+        d = (data or {}).get("data", {})
+        return {
+            "btc_dominance_pct": float(d["market_cap_percentage"]["btc"]),
+            "eth_dominance_pct": float(d["market_cap_percentage"].get("eth", 0.0)),
+            "total_mcap_usd": float(d["total_market_cap"]["usd"]),
+            "total_mcap_chg_24h_pct": float(d.get("market_cap_change_percentage_24h_usd", 0.0)),
+            "ts": int(time.time() * 1000),
+        }
+    except (TypeError, ValueError, KeyError):
+        return None
+
+
+def coinmarketcap_global(api_key: str | None) -> dict | None:
+    """
+    Optional. CoinMarketCap's API requires a key (unlike CoinGecko/OKX/Bybit/
+    Crypto.com above). Returns None if no key is configured — this source is
+    then simply absent from cross_market_regime() rather than erroring.
+    Set the key via config.yaml: aggregators.coinmarketcap_api_key (or the
+    CMC_API_KEY environment variable).
+    """
+    if not api_key:
+        return None
+    try:
+        r = requests.get(
+            "https://pro-api.coinmarketcap.com/v1/global-metrics/quotes/latest",
+            headers={**_UA, "X-CMC_PRO_API_KEY": api_key},
+            timeout=6.0,
+        )
+        if r.status_code >= 400:
+            return None
+        d = r.json().get("data", {})
+        q = d.get("quote", {}).get("USD", {})
+        return {
+            "btc_dominance_pct": float(d.get("btc_dominance", 0.0)),
+            "total_mcap_usd": float(q.get("total_market_cap", 0.0)),
+            "total_mcap_chg_24h_pct": float(q.get("total_market_cap_yesterday_percentage_change", 0.0)),
+            "ts": int(time.time() * 1000),
+        }
+    except (requests.RequestException, ValueError, TypeError, KeyError):
+        return None
+
+
+def cmc_api_key() -> str | None:
+    import os
+
+    return get("aggregators.coinmarketcap_api_key") or os.environ.get("CMC_API_KEY")
