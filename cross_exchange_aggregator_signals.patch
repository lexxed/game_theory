@@ -0,0 +1,108 @@
+import json
+import sys
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from src.storage import Storage  # noqa: E402
+import attribution  # noqa: E402
+
+
+@pytest.fixture()
+def tmp_storage(tmp_path, monkeypatch):
+    import config
+
+    monkeypatch.setattr(config, "get", config.get)  # keep default resolution
+    st = Storage.__new__(Storage)
+    import duckdb
+
+    st.db_path = tmp_path / "test.duckdb"
+    st.parquet_dir = tmp_path / "parquet"
+    st.parquet_dir.mkdir(parents=True, exist_ok=True)
+    import threading
+
+    st._lock = threading.Lock()
+    st.con = duckdb.connect(str(st.db_path))
+    from src.storage import _SCHEMA
+
+    for sql in _SCHEMA.values():
+        st.con.execute(sql)
+    st._migrate()
+    return st
+
+
+def _make_row(ts, raw_val):
+    components = {
+        "long_setup": [
+            {"name": "fake_signal", "raw": raw_val, "normalized": raw_val, "weight": 10, "points": raw_val * 10, "reason": "x"},
+        ],
+        "short_setup": [
+            {"name": "fake_signal", "raw": raw_val, "normalized": raw_val, "weight": 10, "points": raw_val * 10, "reason": "x"},
+        ],
+    }
+    return {
+        "symbol": "BTCUSDT",
+        "ts": ts,
+        "long_setup": 50.0,
+        "long_confirm": 0.0,
+        "short_setup": 50.0,
+        "short_confirm": 0.0,
+        "cascade_long": 0.0,
+        "cascade_short": 0.0,
+        "state": "NEUTRAL",
+        "components_json": json.dumps(components),
+    }
+
+
+def test_attribution_finds_signal_correlated_with_forward_return(tmp_storage, monkeypatch):
+    # Build 15m candles that go DOWN whenever fake_signal was high (raw~1)
+    # and stay FLAT when fake_signal was low (raw~0), so a long_setup
+    # component with raw~1 should show a positive IC (it predicted the
+    # adverse-for-longs move) once the sign convention is applied.
+    base_ts = 1_700_000_000_000
+    step = 15 * 60_000
+    rows = []
+    price = 100.0
+    for i in range(30):
+        ts = base_ts + i * step
+        raw = 1.0 if i % 2 == 0 else 0.0
+        rows.append(_make_row(ts, raw))
+        # Candle close AT ts reflects price before today's signal has had any
+        # effect; the drop associated with `raw` shows up in the NEXT candle,
+        # i.e. in the forward return measured FROM ts. This is what makes
+        # `raw` predictive of the forward move rather than concurrent with it.
+        rows.append({"open_time": ts, "close": price})
+        price = price * (0.98 if raw == 1.0 else 1.0)
+
+    scores_df = pd.DataFrame([r for r in rows if "components_json" in r])
+    candles_df = pd.DataFrame([r for r in rows if "open_time" in r])
+    candles_df["symbol"] = "BTCUSDT"
+    candles_df["interval"] = "15m"
+    candles_df["open"] = candles_df["close"]
+    candles_df["high"] = candles_df["close"]
+    candles_df["low"] = candles_df["close"]
+    candles_df["volume"] = 0.0
+    candles_df["closed"] = True
+
+    tmp_storage.upsert_df("scores", scores_df)
+    tmp_storage.upsert_df(
+        "candles",
+        candles_df[["symbol", "interval", "open_time", "open", "high", "low", "close", "volume", "closed"]],
+    )
+
+    monkeypatch.setattr(attribution, "Storage", lambda: tmp_storage)
+    out = attribution.attribute("BTCUSDT", "long")
+    assert not out.empty
+    row = out[out["component"] == "fake_signal"].iloc[0]
+    # raw=1 preceded price DOWN -> for long_setup (trap/vulnerability score)
+    # that is the intended direction -> IC should be meaningfully positive.
+    assert row["ic_spearman_15m"] > 0.3
+
+
+def test_attribution_empty_when_no_scores(tmp_storage, monkeypatch):
+    monkeypatch.setattr(attribution, "Storage", lambda: tmp_storage)
+    out = attribution.attribute("BTCUSDT", "long")
+    assert out.empty
