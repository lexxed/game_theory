+        # --- cross-exchange funding divergence (Binance vs OKX/Bybit) ---
+        # A crowding/funding read that only exists on Binance (not the rest of
+        # the market) is weaker evidence than one shared across venues.
+        ext = s.get("external") or {}
+        fdiv = ext.get("cross_funding_divergence")
+        if fdiv is None:
+            raw = 0.0
+            reason = ext.get("cross_funding_reason", "no cross-exchange funding data")
+        else:
+            fdiv = float(fdiv)
+            href = float(refs.get("funding_high", 0.0005))
+            if side == "long":
+                raw = clip(fdiv / href) if fdiv > 0 else 0.0
+            else:
+                raw = clip((-fdiv) / href) if fdiv < 0 else 0.0
+            reason = ext.get("cross_funding_reason", "")
+        comps.append(_comp("cross_funding_divergence", fdiv if fdiv is not None else 0.0, raw,
+                            w.get("cross_funding_divergence", 0), reason))
+
+        # --- market regime (BTC dominance momentum + total mcap direction) ---
+        # Coarse context filter from CoinGecko/CMC, not a per-symbol signal:
+        # a long-trap read strengthens if dominance is rising / total mcap is
+        # rolling over (risk-off, alt longs more crowded and more exposed);
+        # a short-trap read strengthens on the mirror case.
+        dom_mom = ext.get("btc_dominance_momentum")
+        mcap_chg = ext.get("total_mcap_chg_24h_pct")
+        if dom_mom is None and mcap_chg is None:
+            raw = 0.0
+            reason = "no aggregator regime data yet (CoinGecko/CoinMarketCap)"
+        else:
+            dom_mom = float(dom_mom or 0.0)
+            mcap_chg = float(mcap_chg or 0.0)
+            if side == "long":
+                raw = clip(0.5 * clip(dom_mom / 0.5) + 0.5 * clip((-mcap_chg) / 2.0))
+                reason = (
+                    f"BTC dominance momentum {dom_mom:+.3f}pp, total mcap 24h {mcap_chg:+.2f}% "
+                    "(dominance up + mcap soft = risk-off, longs more exposed)"
+                )
+            else:
+                raw = clip(0.5 * clip((-dom_mom) / 0.5) + 0.5 * clip(mcap_chg / 2.0))
+                reason = (
+                    f"BTC dominance momentum {dom_mom:+.3f}pp, total mcap 24h {mcap_chg:+.2f}% "
+                    "(dominance down + mcap strong = risk-on, shorts more exposed)"
+                )
+        comps.append(_comp("market_regime", dom_mom if dom_mom is not None else 0.0, raw,
+                            w.get("market_regime", 0), reason))
+
         total = round(sum(c.points for c in comps), 2)
