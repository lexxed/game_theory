+++ b/attribution.py
@@ -0,0 +1,221 @@
+"""
+Per-signal attribution: which scoring components actually correlate with
+what happened afterward, at each horizon.
+
+This is deliberately separate from backtest.py, which reports forward
+returns after the *total* score crosses a threshold. attribution.py instead
+explodes stored snapshots into one row per (timestamp, component) and asks,
+for each component independently: when this component's raw value / points
+were high, did forward returns skew the direction the component implies?
+
+Metrics per component x horizon:
+  n           - snapshots where the component had a non-degenerate raw value
+  ic_pearson  - Pearson correlation of component.raw vs forward return
+  ic_spearman - Spearman (rank) correlation — more robust to outliers/units
+  top_q_ret   - mean forward return when raw is in the top quintile
+  bot_q_ret   - mean forward return when raw is in the bottom quintile
+  spread      - top_q_ret - bot_q_ret (the useful number: does high vs low
+                actually separate outcomes, regardless of sign convention)
+
+IC is computed against SIGNED forward return for the "long_setup" family and
+against the mirrored (negated) forward return for "short_setup" so that, in
+both cases, a positive IC means "this component moving toward its intended
+direction is followed by the intended (adverse, since these are trap-risk
+scores) move." Read: for long_setup components, positive IC means high
+component values preceded price going DOWN in that horizon — this is a trap/
+vulnerability score, not a long signal.
+
+LIMIT: correlational, not causal, not walk-forward, no transaction costs.
+This tells you which components are worth keeping/reweighting/replacing —
+it is not a validated trading edge. Small n per component is common early on
+(a component only enters the report once it has fired with a non-zero raw
+value); treat n < 30 as exploratory only.
+
+Usage (from this folder):
+    python attribution.py
+    python attribution.py --symbol BTCUSDT --side long --top 15
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+ROOT = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT))
+
+from src.storage import Storage  # noqa: E402
+from backtest import HORIZONS  # noqa: E402
+
+
+def load_scores_and_candles(symbol: str) -> tuple[pd.DataFrame, pd.DataFrame]:
+    st = Storage()
+    scores = st.query(
+        "SELECT ts, state, components_json FROM scores WHERE symbol = ? ORDER BY ts",
+        [symbol],
+    )
+    candles = st.query(
+        "SELECT open_time, close FROM candles WHERE symbol = ? AND interval = '15m' ORDER BY open_time",
+        [symbol],
+    )
+    return scores, candles
+
+
+def _forward_returns(ts_series: pd.Series, candles: pd.DataFrame) -> pd.DataFrame:
+    """For each ts, forward return at each horizon vs the 15m candle close
+    at-or-before ts. Same join logic as backtest.forward_stats, factored out
+    so both tools stay consistent."""
+    if candles.empty:
+        return pd.DataFrame(index=ts_series.index)
+    candles = candles.sort_values("open_time")
+    closes = candles["close"].to_numpy()
+    times = candles["open_time"].to_numpy()
+    out = {f"ret_{name}": [] for name in HORIZONS}
+    for ts in ts_series:
+        ts = int(ts)
+        i = int((times <= ts).sum() - 1)
+        if i < 0 or i >= len(closes) - 1:
+            for name in HORIZONS:
+                out[f"ret_{name}"].append(None)
+            continue
+        entry = float(closes[i])
+        for name, ms in HORIZONS.items():
+            j = int((times <= ts + ms).sum() - 1)
+            out[f"ret_{name}"].append(closes[j] / entry - 1.0 if j > i else None)
+    return pd.DataFrame(out, index=ts_series.index)
+
+
+def explode_components(scores: pd.DataFrame, side: str) -> pd.DataFrame:
+    """One row per (ts, component_name) with raw/normalized/points."""
+    key = f"{side}_setup"
+    rows = []
+    for _, r in scores.iterrows():
+        blob = r.get("components_json")
+        if not blob:
+            continue
+        try:
+            comps = json.loads(blob).get(key, [])
+        except (TypeError, ValueError):
+            continue
+        for c in comps:
+            rows.append(
+                {
+                    "ts": r["ts"],
+                    "state": r.get("state"),
+                    "component": c.get("name"),
+                    "raw": c.get("raw"),
+                    "normalized": c.get("normalized"),
+                    "points": c.get("points"),
+                }
+            )
+    return pd.DataFrame(rows)
+
+
+def _quintile_spread(raw: pd.Series, ret: pd.Series) -> tuple[float | None, float | None]:
+    """Top vs bottom quintile mean return. Falls back to a simple median
+    split for low-cardinality (e.g. binary flag) components, since pd.qcut
+    needs enough distinct values to carve 5 real bins."""
+    df = pd.DataFrame({"raw": raw, "ret": ret}).dropna()
+    if len(df) < 10 or df["raw"].nunique() < 2:
+        return None, None
+    if df["raw"].nunique() < 5:
+        med = df["raw"].median()
+        top = df.loc[df["raw"] > med, "ret"]
+        bot = df.loc[df["raw"] <= med, "ret"]
+        if top.empty or bot.empty:
+            return None, None
+        return float(top.mean()), float(bot.mean())
+    try:
+        df["q"] = pd.qcut(df["raw"], 5, labels=False, duplicates="drop")
+    except ValueError:
+        return None, None
+    if df["q"].max() < df["q"].min() + 1:
+        return None, None
+    top = df.loc[df["q"] == df["q"].max(), "ret"].mean()
+    bot = df.loc[df["q"] == df["q"].min(), "ret"].mean()
+    return float(top), float(bot)
+
+
+def attribute(symbol: str, side: str) -> pd.DataFrame:
+    scores, candles = load_scores_and_candles(symbol)
+    if scores.empty:
+        return pd.DataFrame()
+    exploded = explode_components(scores, side)
+    if exploded.empty:
+        return pd.DataFrame()
+    fwd = _forward_returns(scores["ts"], candles)
+    fwd.index = scores.index
+    scores = scores.join(fwd)
+    ts_to_rets = scores.set_index("ts")[[f"ret_{h}" for h in HORIZONS]]
+    exploded = exploded.join(ts_to_rets, on="ts")
+
+    # Trap-risk scores predict an ADVERSE move. Mirror the sign for shorts
+    # so that positive IC always means "component correctly anticipated the
+    # direction its own name implies" across both long and short reports.
+    sign = -1.0 if side == "long" else 1.0
+
+    rows = []
+    for name, grp in exploded.groupby("component"):
+        rec = {"component": name}
+        nz = grp[grp["raw"].abs() > 1e-9]
+        rec["n_nonzero"] = int(len(nz))
+        for h in HORIZONS:
+            col = f"ret_{h}"
+            d = grp[["raw", col]].dropna()
+            if len(d) < 10 or d["raw"].nunique() < 2:
+                rec[f"ic_pearson_{h}"] = None
+                rec[f"ic_spearman_{h}"] = None
+                rec[f"spread_{h}"] = None
+                continue
+            signed_ret = sign * d[col]
+            rec[f"ic_pearson_{h}"] = float(np.corrcoef(d["raw"], signed_ret)[0, 1])
+            rec[f"ic_spearman_{h}"] = float(
+                pd.Series(d["raw"]).rank().corr(pd.Series(signed_ret).rank())
+            )
+            top, bot = _quintile_spread(d["raw"], signed_ret)
+            rec[f"spread_{h}"] = (top - bot) if (top is not None and bot is not None) else None
+        rows.append(rec)
+    out = pd.DataFrame(rows)
+    if out.empty:
+        return out
+    rank_col = f"ic_spearman_{list(HORIZONS)[1]}"  # default sort: 15m horizon
+    if rank_col in out.columns:
+        order = pd.to_numeric(out[rank_col], errors="coerce").abs().sort_values(ascending=False, na_position="last").index
+        out = out.reindex(order)
+    return out.reset_index(drop=True)
+
+
+def main() -> None:
+    p = argparse.ArgumentParser(description="Per-signal attribution: does each component's raw value correlate with forward returns?")
+    p.add_argument("--symbol", default="BTCUSDT")
+    p.add_argument("--side", default="long", choices=["long", "short"])
+    p.add_argument("--top", type=int, default=20, help="max rows to print")
+    args = p.parse_args()
+
+    out = attribute(args.symbol, args.side)
+    if out.empty:
+        print(f"No stored components for {args.symbol} ({args.side}_setup) yet, or no overlapping candle history.")
+        print("Run the dashboard so snapshots flush to DuckDB (components_json requires this update to market_data.py).")
+        return
+
+    print(f"Per-signal attribution — {args.symbol} {args.side}_setup components")
+    print(f"n_nonzero = snapshots where the component fired with a non-zero raw value; treat n < 30 as exploratory.\n")
+    show_cols = ["component", "n_nonzero"] + [
+        c for h in HORIZONS for c in (f"ic_spearman_{h}", f"spread_{h}")
+    ]
+    print(out[show_cols].head(args.top).to_string(index=False, float_format=lambda x: f"{x:+.4f}"))
+    print()
+    print("Reading this: ic_spearman near 0 = component isn't separating outcomes at that horizon.")
+    print("spread = mean forward return (top quintile) - mean forward return (bottom quintile) of the")
+    print("component's own raw value, sign-adjusted so positive always means 'worked as intended.'")
+    print()
+    print("LIMIT: correlational, not causal, no transaction costs, no walk-forward split. Not a validated edge.")
+
+
+if __name__ == "__main__":
+    main()
